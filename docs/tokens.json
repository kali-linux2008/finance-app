{
  "$description": "Ontwerpwaarden voor de app (v4). Kleuren per thema, typografie, ruimte, radii, schaduwen, beweging.",
  "color": {
    "dark": {
      "bg": "#15140F", "surface": "#1E1C17", "surface2": "#2A2822",
      "surfaceGrad": "linear-gradient(180deg,#22201A,#1C1A15)",
      "ink": "#F2EEE4", "muted": "#A39D90", "faint": "#6F6A60", "line": "rgba(255,250,240,.09)",
      "accent": "#8EA2F0", "onAccent": "#0F1530", "accentSoft": "#2A3360",
      "gold": "#D9BC82", "onGold": "#241D0E", "goldLine": "rgba(217,188,130,.35)",
      "champagne": "#F6E7C4", "heroLabel": "#E2CB98", "heroMuted": "#C4CCEF",
      "pos": "#6BC48F", "neg": "#E8826E", "scrim": "rgba(0,0,0,.55)",
      "heroBg": "radial-gradient(130% 90% at 100% 0%,#4361D6 0%,#2840A8 42%,#141F5A 100%)",
      "heroFrame": "linear-gradient(135deg,rgba(232,207,154,.75),rgba(217,188,130,.08) 38%,rgba(217,188,130,.06) 62%,rgba(232,207,154,.55))",
      "btnBg": "linear-gradient(180deg,#A3B4F6,#7F95EA)",
      "class": { "equity": "#2A3B8F", "crypto": "#4A3F25", "cash": "#2C3A31", "payment": "#2A2822", "gold": "#3A3224" }
    },
    "light": {
      "bg": "#F5F0E6", "surface": "#FDFAF3", "surface2": "#ECE5D6",
      "surfaceGrad": "linear-gradient(180deg,#FFFDF8,#F7F1E4)",
      "ink": "#1B1912", "muted": "#6B665B", "faint": "#A39D90", "line": "rgba(90,66,24,.11)",
      "accent": "#3550C9", "onAccent": "#FFFFFF", "accentSoft": "#E1E6F8",
      "gold": "#8A6420", "onGold": "#FFF8E6", "goldLine": "rgba(138,100,32,.42)",
      "pos": "#2F7A4F", "neg": "#B3412E", "scrim": "rgba(23,24,28,.4)",
      "heroBg": "radial-gradient(130% 90% at 100% 0%,#4F6AE0 0%,#2B43B5 42%,#16226A 100%)",
      "heroFrame": "linear-gradient(135deg,rgba(201,163,95,.95),rgba(201,163,95,.18) 38%,rgba(201,163,95,.12) 62%,rgba(201,163,95,.8))",
      "btnBg": "linear-gradient(180deg,#4A66DE,#2A41B0)",
      "class": { "equity": "#1F2A5C", "crypto": "#E8D9B4", "cash": "#D6DED6", "payment": "#E6E1D5", "gold": "#EDE2CA" }
    }
  },
  "font": {
    "serif": "Source Serif 4", "sans": "Manrope", "icons": "Material Symbols Outlined",
    "numeric": "tabular-nums", "locale": "nl-NL", "minus": "\u2212"
  },
  "type": {
    "heroAmount": { "family": "serif", "size": 46, "lineHeight": 1.05 },
    "screenTitle": { "family": "serif", "size": 30 },
    "detailPrice": { "family": "serif", "size": 38 },
    "sectionTitle": { "family": "serif", "size": 20 },
    "goldCaption": { "family": "sans", "size": 11, "weight": 600, "letterSpacing": "0.14em", "transform": "uppercase", "rule": "14x1px gold" },
    "row": { "family": "sans", "size": 15, "weight": 600 },
    "sub": { "family": "sans", "size": 12 },
    "button": { "family": "sans", "size": 15, "weight": 700 }
  },
  "space": {
    "screenText": 24, "cardInset": 16, "sectionTop": 30, "sectionBottom": 12,
    "cardGap": 12, "cardPadding": 20, "rowPadding": [13, 16], "rowGap": 12
  },
  "radius": { "hero": 28, "card": 20, "tile": 18, "chip": 10, "pill": 999, "button": 26, "sheet": 28, "appIcon": "28%" },
  "size": { "button": 52, "nav": 64, "fab": 64, "rowIcon": 40, "minTarget": 44 },
  "shadow": {
    "hero": "0 28px 56px -28px rgba(30,50,170,.85), inset 0 1px 0 rgba(255,255,255,.14)",
    "buttonDark": "inset 0 1px 0 rgba(255,255,255,.45), 0 0 0 1px rgba(217,188,130,.35), 0 12px 24px -12px rgba(142,162,240,.7)"
  },
  "motion": {
    "screenIn": { "ms": 400, "easing": "cubic-bezier(.2,.8,.2,1)", "from": "translateX(28px), opacity 0" },
    "rowStagger": { "ms": 450, "delayPerRow": 35, "maxRows": 12 },
    "countUp": { "ms": 1500, "easing": "easeOutQuart" },
    "chartDraw": { "ms": 1200 },
    "sheet": { "ms": 250 },
    "toast": { "visibleMs": 2400 }
  }
}
